# Copy this file to "db.properties" (same folder as src/) and put YOUR MySQL password below.
# db.properties is ignored by git, so passwords never get pushed to GitHub.
db.url=jdbc:mysql://localhost:3306/sportgrid?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
db.user=root
db.password=your_mysql_password_here
